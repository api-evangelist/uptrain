{
  "opencollection": "1.0.0",
  "info": {
    "name": "UpTrain Managed Evaluation Auth Datasets API",
    "version": "0.7.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "uptrain-access-token",
      "value": "{{uptrain-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a dataset by name.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://demo.uptrain.ai/api/public/dataset",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a dataset by name."
        },
        {
          "info": {
            "name": "Upload an evaluation dataset.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://demo.uptrain.ai/api/public/dataset",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload an evaluation dataset."
        }
      ]
    }
  ],
  "bundled": true
}